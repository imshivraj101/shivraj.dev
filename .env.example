# Canonical origin. Set this in Vercel when a custom domain is added -
# canonicals, sitemap, robots, feed, llms.txt and JSON-LD all follow it.
NEXT_PUBLIC_SITE_URL=https://shivraj-dev-eta.vercel.app

# Search engine verification. Each is optional: an unset value simply
# omits its meta tag rather than emitting an empty one.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=        # Bing Webmaster Tools -> msvalidate.01
YANDEX_VERIFICATION=           # Yandex Webmaster

# IndexNow: 8-128 hex characters, generated at bing.com/indexnow.
# Served at /<key>.txt; used by scripts/indexnow.mjs.
INDEXNOW_KEY=
